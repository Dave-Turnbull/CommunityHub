APP_NAME=CommunityHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=communityhub
DB_USERNAME=communityhub
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=10080
CACHE_STORE=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=communityhub
REVERB_APP_KEY=communityhub-key
REVERB_APP_SECRET=communityhub-secret
# Server-side host the app/worker containers use to PUBLISH events to Reverb
# over HTTP — must be the docker-compose service name, not "localhost" (see
# CLAUDE.md trap on this).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=true

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# Browser-facing host — the host machine, where the reverb container's port
# is published. Deliberately NOT derived from REVERB_HOST (see above).
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# coturn (STUN/TURN for WebRTC voice). No VITE_TURN_* counterpart exists —
# unlike Reverb's static app key, TURN credentials are ephemeral and fetched
# at runtime from GET /api/voice/ice-servers, so the browser never needs the
# host baked into the JS bundle. TURN_PUBLIC_HOST is still the browser-facing
# value (the host machine, "localhost" in dev) even though it's read by PHP,
# not Vite — same reasoning as VITE_REVERB_HOST, different consumer.
TURN_SECRET=communityhub-turn-secret
TURN_REALM=communityhub
TURN_PORT=3478
TURN_PUBLIC_HOST=localhost

# mailpit (dev catcher, default) | smtp (any real provider) | log | array | ses
MAIL_MAILER=mailpit
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@communityhub.test
MAIL_FROM_NAME="${APP_NAME}"

# Only used when MAIL_MAILER=ses — separate from the AWS_* creds below, which
# are R2 storage credentials and won't work against real AWS services.
MAIL_SES_KEY=
MAIL_SES_SECRET=
MAIL_SES_REGION=us-east-1

FILESYSTEM_DISK=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
